<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.paperclip-selfcheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__HERMES_ROOT__/launchd/run-node.sh</string>
    <string>__HERMES_ROOT__/selfcheck.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HERMES_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>Umask</key>
  <string>077</string>
  <key>StandardOutPath</key>
  <string>__HERMES_ROOT__/logs/selfcheck.log</string>
  <key>StandardErrorPath</key>
  <string>__HERMES_ROOT__/logs/selfcheck.err.log</string>
</dict>
</plist>
