<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.paperclip-selfcheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/path/to/hermes-relay/launchd/run-node.sh</string>
    <string>/path/to/hermes-relay/selfcheck.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/hermes-relay</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/path/to/hermes-relay/logs/selfcheck.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/hermes-relay/logs/selfcheck.err.log</string>
</dict>
</plist>
