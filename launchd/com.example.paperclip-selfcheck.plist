<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.paperclip-selfcheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>/path/to/hermes-relay/selfcheck.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/hermes-relay</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$HOME/.nvm/versions/node/v22.22.3/bin:/path/to/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/path/to/hermes-relay/logs/selfcheck.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/hermes-relay/logs/selfcheck.err.log</string>
</dict>
</plist>
