<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.paperclip-notifier</string>
  <!-- run-node.sh also fixes the old PATH here, which omitted /opt/homebrew/bin. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/path/to/hermes-relay/launchd/run-node.sh</string>
    <string>/path/to/hermes-relay/notifier.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/hermes-relay</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/path/to/hermes-relay/logs/notifier.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/hermes-relay/logs/notifier.err.log</string>
</dict>
</plist>
