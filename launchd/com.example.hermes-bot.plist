<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.hermes-bot</string>
  <!-- run-node.sh resolves node via nvm at run time — never bake a
       version-pinned nvm bin dir into PATH here (breaks on nvm install). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__HERMES_ROOT__/launchd/run-node.sh</string>
    <string>__HERMES_ROOT__/hermes-bot.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HERMES_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- SuccessfulExit=false, NOT bool true: a bool-true job restarts even after
       a deliberate clean exit, so the bot could never stop itself on purpose. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- SIGTERM handler checkpoints (flush coalesced ledger edits, save state);
       give it a real window before launchd escalates to SIGKILL. -->
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>Umask</key>
  <string>077</string>
  <key>StandardOutPath</key>
  <string>__HERMES_ROOT__/logs/hermes.log</string>
  <key>StandardErrorPath</key>
  <string>__HERMES_ROOT__/logs/hermes.err.log</string>
</dict>
</plist>
