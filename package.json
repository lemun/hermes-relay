{
  "name": "hermes-relay",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "Shai Sinai",
  "description": "Hermes — the phone-side hub for Shai's GitHub-issue pipeline: ratification relay (ask_owner → one-tap Telegram answers), headless grilling/dispatch/finisher sessions, plus the dormant Paperclip bridge (ntfy notifier + board concierge).",
  "scripts": {
    "notifier": "node notifier.mjs",
    "notifier:once": "node notifier.mjs --once",
    "selfcheck": "node selfcheck.mjs",
    "selfcheck:dry": "node selfcheck.mjs --dry-run",
    "hermes": "node hermes-bot.mjs",
    "mcp": "node paperclip-mcp.mjs",
    "ask-mcp": "node hermes-ask-mcp.mjs",
    "whoami": "node hermes-bot.mjs --whoami",
    "check": "node hermes-bot.mjs --check",
    "labels:check": "node scripts/check-labels.mjs",
    "labels:bootstrap": "node scripts/check-labels.mjs --apply",
    "live:check": "node scripts/live-ops.mjs check",
    "live:restart": "node scripts/live-ops.mjs restart",
    "install:update": "node scripts/install-update.mjs",
    "security:check": "node scripts/security-check.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemun/hermes-relay.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
