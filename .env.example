# Hermes secrets. Copy to .env, keep it owner-only, and never commit or paste values.

# BotFather-issued token.
TELEGRAM_BOT_TOKEN=

# Exact private chat and sender IDs. Both are required for host-capable modes.
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=

# Base32 RFC 6238 secret for short-lived step-up authorization.
HERMES_TOTP_SECRET=
