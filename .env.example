# Secrets for the Paperclip bridge. Copy to .env (which is gitignored).
# These override the matching fields in config.json, so config.json can stay
# secret-free and committable.

# Telegram bot token from @BotFather (the ONE real secret here).
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat id (run `npm run whoami`, DM the bot, it prints this).
TELEGRAM_CHAT_ID=

# Your numeric Telegram user id. Hermes requires both this and TELEGRAM_CHAT_ID,
# and accepts commands only from this user in a private chat.
TELEGRAM_USER_ID=

# Base32 RFC 6238 secret used for short-lived step-up authorization. Keep it
# out of config.json. Run /auth <code> before a sensitive command or callback.
HERMES_TOTP_SECRET=

# ntfy topic — semi-secret: anyone who knows it can READ every alert AND PUBLISH fake
# alerts to your phone. Pick your own long, unguessable value (e.g. `hermes-paperclip-$(uuidgen)`)
# and keep it ONLY here in .env, never committed. Do NOT reuse an example value.
NTFY_TOPIC=CHANGEME

# Optional: self-hosted ntfy server (defaults to https://ntfy.example.com).
# NTFY_SERVER=https://ntfy.example.com

# Optional: board write key — enables confirm-gated /accept and /reject. Empty = read-only
# (fail-closed: the bridge refuses to write the board without it). Get it from Paperclip.
# PAPERCLIP_BOARD_API_KEY=
